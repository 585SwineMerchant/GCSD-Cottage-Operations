});

const STARTER_PATHWAY_CATEGORIES = Object.freeze({
  2: "Breads, Pasta, Grains & Fermentation",
  4: "Protein, Eggs & Dairy",
  5: "Stocks, Sauces & Soups",
  6: "Produce & Preservation",
  7: "Baking & Pastry",
  8: "Global Cuisine"
});

/**
 * Imports the source-approved Culinary 1 & 2 starter recipe book into the
 * teacher Recipe Library. No Cloudflare state, accounts, events, submissions,
 * or audit records are read.
 * Exact recipe IDs and names make this safe to rerun.
 */
function seedStarterRecipeLibrary_() {
  if (typeof STARTER_PATHWAY_RECIPES === "undefined" || !Array.isArray(STARTER_PATHWAY_RECIPES)) return { added: 0, skipped: 0 };
  const teacher = assertTeacher_();
  const existing = records_(SHEETS.RECIPES);
  const existingIds = new Set(existing.map(item => String(item.recipe_id)));
  const existingNames = new Set(existing.map(item => String(item.name || "").trim().toLowerCase()).filter(Boolean));
  const now = new Date().toISOString();
  let added = 0, skipped = 0;

  STARTER_PATHWAY_RECIPES.forEach(source => {
    const recipeId = `seed_${source.id}`;
    const nameKey = String(source.name || "").trim().toLowerCase();
    if (existingIds.has(recipeId) || existingNames.has(nameKey)) { skipped += 1; return; }

    const record = {
      recipe_id: recipeId,
      name: clean_(source.name, 300),
      category: clean_(STARTER_PATHWAY_CATEGORIES[Number(source.unit)] || `Culinary Arts 1 & 2 · Unit ${source.unit}`, 100),
      status: "Approved",
      current_version: 1,
      standard_yield_quantity: positiveNumber_(source.yield, 0),
      standard_yield_unit: clean_(STARTER_PATHWAY_YIELD_UNITS[source.id] || "portions", 100),
      portion_size: clean_(source.portion, 200),
      allergens: "Teacher verification required",
      competencies: clean_(`${source.course} · Unit ${source.unit}`, 2000),
      ingredients_json: JSON.stringify(legacyRecipeIngredients_(source.ingredients || [])),
      equipment_json: JSON.stringify(list_(source.equipment || [], 100, 200)),
      procedure_json: JSON.stringify(list_(source.procedure || [], 200, 1000)),
      safety_controls: "Verify allergens, substitutions, required temperatures, holding limits, and current food-safety requirements before production.",
      quality_controls_json: JSON.stringify(["Teacher verification required before production."]),
      created_at: now,
      created_by: teacher.email,
      updated_at: now,
      updated_by: teacher.email
    };
    const snapshot = recipeSnapshotFromRecord_(record, 1, "Approved");
    appendRecord_(SHEETS.RECIPES, record);
    appendRecord_(SHEETS.RECIPE_VERSIONS, {
      recipe_version_id: id_("rcpv"),
      recipe_id: recipeId,
      version: 1,
      status: "Approved",
      created_at: now,
      created_by: teacher.email,
      change_note: `Source-approved Culinary 1 & 2 starter recipe. Source: ${source.source || "GCSD Culinary 1 & 2 Recipe Book"}; original ID: ${source.id}.`,
      snapshot_json: JSON.stringify(snapshot)
    });
    existingIds.add(recipeId);
    existingNames.add(nameKey);
    added += 1;
  });

  if (added) audit_(teacher.email, "seed_pathway_recipes", "recipe_library", "starter-pathway", { added, skipped, sourceRepository: "585SwineMerchant/GCSD-Culinary-1-2-Field-Manual" });
  return { added, skipped, total: STARTER_PATHWAY_RECIPES.length };
}

function legacyRecipeIngredients_(lines) {
  return (Array.isArray(lines) ? lines : [])
    .map(legacyRecipeIngredient_)
    .filter(Boolean)
    .slice(0, 200);
}

function legacyRecipeIngredient_(value) {
  let line = String(value || "").replace(/\s+/g, " ").trim();
  if (!line || /:\s*$/.test(line)) return null;

  const unicodeFractions = { "¼": .25, "½": .5, "¾": .75, "⅓": 1 / 3, "⅔": 2 / 3, "⅛": .125, "⅜": .375, "⅝": .625, "⅞": .875 };
  const amount = "(?:\\d+\\s+\\d+\\/\\d+|\\d+\\s*[¼½¾⅓⅔⅛⅜⅝⅞]|\\d+\\/\\d+|\\d+(?:\\.\\d+)?|[¼½¾⅓⅔⅛⅜⅝⅞])";
  const units = "(?:fl\\s*oz|tablespoons?|tbsp|teaspoons?|tsp|pounds?|lbs?|ounces?|oz|cups?|quarts?|pints?|gallons?|grams?|kilograms?|milliliters?|liters?|cloves?|bunch(?:es)?|cans?|packages?|each|[Ttc]|g|kg|ml|l)";
  const start = line.match(new RegExp("^(" + amount + ")(?:\\s*[-–]\\s*(" + amount + "))?\\s*(" + units + ")?\\.?\\s+(.*)$", "i"));

  if (start) {
    let name = String(start[4] || "").replace(/^\([^)]*\)\s*/, "").trim();
    const unit = legacyRecipeUnit_(start[3] || "each");
    if (!name) name = line;
    const parts = legacyRecipePreparation_(name);
    if (start[2]) {
      return { name: parts.name, quantity: 0, quantityText: `${start[1]}–${start[2]} ${unit}`, unit: "", preparation: parts.preparation };
    }
    return { name: parts.name, quantity: legacyRecipeQuantity_(start[1], unicodeFractions), quantityText: "", unit, preparation: parts.preparation };
  }

  const reverse = line.match(new RegExp("^(.*?)\\s+(" + amount + ")(?:\\s*[-–]\\s*(" + amount + "))?\\s*(" + units + ")(?:\\s+|$)(.*)$", "i"));
  if (reverse && String(reverse[1] || "").trim()) {
    const unit = legacyRecipeUnit_(reverse[4]);
    const parts = legacyRecipePreparation_([reverse[1], reverse[5]].filter(Boolean).join(" ").replace(/^\([^)]*\)\s*/, "").trim());
    if (reverse[3]) {
      return { name: parts.name, quantity: 0, quantityText: `${reverse[2]}–${reverse[3]} ${unit}`, unit: "", preparation: parts.preparation };
    }
    return { name: parts.name, quantity: legacyRecipeQuantity_(reverse[2], unicodeFractions), quantityText: "", unit, preparation: parts.preparation };
  }

  return { name: line, quantity: 0, quantityText: "as needed / verify", unit: "", preparation: "" };
}

function legacyRecipeQuantity_(value, fractions) {
  const text = String(value || "").trim();
  const mixed = text.match(/^(\d+)\s+(\d+)\/(\d+)$/);
  const fraction = text.match(/^(\d+)\/(\d+)$/);
  const unicode = text.match(/^(\d+)?\s*([¼½¾⅓⅔⅛⅜⅝⅞])$/);
  if (mixed && Number(mixed[3])) return Number(mixed[1]) + Number(mixed[2]) / Number(mixed[3]);
  if (fraction && Number(fraction[2])) return Number(fraction[1]) / Number(fraction[2]);
  if (unicode) return Number(unicode[1] || 0) + Number(fractions[unicode[2]] || 0);
  return positiveNumber_(text, 0);
}

function legacyRecipeUnit_(value) {
  const raw = String(value || "").replace(/\./g, "").replace(/\s+/g, " ").trim();
  const lower = raw.toLowerCase();
  const aliases = {
    t: "tbsp", tablespoon: "tbsp", tablespoons: "tbsp", tbsp: "tbsp",
    teaspoon: "tsp", teaspoons: "tsp", tsp: "tsp",
    c: "cup", cup: "cup", cups: "cup",
    pound: "lb", pounds: "lb", lb: "lb", lbs: "lb",
    ounce: "oz", ounces: "oz", oz: "oz",
    gram: "g", grams: "g", g: "g", kilogram: "kg", kilograms: "kg", kg: "kg",
    milliliter: "ml", milliliters: "ml", ml: "ml", liter: "l", liters: "l", l: "l",
    quart: "qt", quarts: "qt", pint: "pt", pints: "pt", gallon: "gal", gallons: "gal",
    clove: "each", cloves: "each", bunch: "each", bunches: "each", can: "each", cans: "each",
    package: "each", packages: "each", each: "each"
  };
  return aliases[lower] || lower || "each";
}

function legacyRecipePreparation_(value) {
  const line = String(value || "").trim();
  const match = line.match(/^(.*?),\s*((?:chilled|cold|softened|melted|diced|minced|chopped|sliced|grated|divided|peeled|beaten|scraped|optional).*)$/i);
  return match ? { name: match[1].trim(), preparation: match[2].trim() } : { name: line, preparation: "" };
}
